  <ItemGroup>
    <!-- CUDA kernel. nvcc compiles straight to a linkable .obj (device code
         embedded); MSBuild auto-links CustomBuild .obj outputs. x64 only -
         CUDA has no ARM64 toolchain. -arch=sm_89 for the RTX 4060 (Ada); NOTE
         the SDK sample's sm_50 is REJECTED by CUDA 13. Uses $(CUDA_PATH) (set
         by the installer) rather than the sample's $(CUDA_SDK_BASE_PATH). -->
    <CustomBuild Include="..\CornerRounder_Kernel.cu">
      <FileType>Document</FileType>
      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">"$(CUDA_PATH)\bin\nvcc.exe" -D_DEBUG -arch=sm_89 -use_fast_math -m64 -c -ccbin "$(VC_ExecutablePath_x64_x64)" -D_MBCS -Xcompiler /MDd,/EHsc,/W3,/nologo,/Zi -I"$(CUDA_PATH)\include" -I./ -I"$(ProjectDir)..\..\..\GPUUtils" -o "$(IntDir)%(Filename).obj" "$(ProjectDir)..\%(Filename).cu"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">$(IntDir)%(Filename).obj</Outputs>
      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">"$(CUDA_PATH)\bin\nvcc.exe" -arch=sm_89 -use_fast_math -m64 -c -ccbin "$(VC_ExecutablePath_x64_x64)" -D_MBCS -Xcompiler /MD,/EHsc,/W3,/nologo,/Zi -I"$(CUDA_PATH)\include" -I./ -I"$(ProjectDir)..\..\..\GPUUtils" -o "$(IntDir)%(Filename).obj" "$(ProjectDir)..\%(Filename).cu"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|x64'">$(IntDir)%(Filename).obj</Outputs>
      <Message>Compiling CUDA kernel %(Filename).cu (nvcc, sm_89)</Message>
    </CustomBuild>
  </ItemGroup>
